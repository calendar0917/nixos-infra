# Local deployment values. `scripts/init.sh` creates the real `.env` with
# mode 0600. Do not commit the real file.
#
# The image is pinned by digest after the first official stable pull. Replace
# it deliberately when upgrading; never leave a floating tag here.
TAILSCALE_IPV4=<current-tailscale-ipv4>
HERMES_IMAGE=nousresearch/hermes-agent@sha256:adb7890916de63245523492be8f68f9d2095fecbec4e2a6dab7960381f0fc002
HERMES_UID=1000
HERMES_GID=1000
