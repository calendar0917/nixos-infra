# Template for deploy/inbox/.env — copy to .env (mode 0600) and fill in.
# The real .env is gitignored and must never be committed or pasted anywhere.
#
# This stack keeps no secret in .env: the mailbox passwords live in SnappyMail's
# own data volume and ntfy credentials live in its auth database. .env stays
# ignored so tokens added later do not leak.

# Pin digests by tag; bump deliberately, never "latest".
# Docker Hub lags the source releases: v3.0.1.2 (2026-11-11) is the newest image
# although upstream source is already at 3.1.4.
SNAPPYMAIL_IMAGE=djmaze/snappymail:v3.0.1.2
NTFY_IMAGE=binwiederhier/ntfy:v2.37.2

# Loopback ports; cloudflared reaches these from 127.0.0.1.
SNAPPYMAIL_PORT=24080
NTFY_PORT=2586

# Must match the public hostname configured in the Cloudflare Tunnel.
NTFY_BASE_URL=https://notify.20050917.xyz

# PHP per-request memory cap and attachment size limit.
SNAPPYMAIL_MEMORY_LIMIT=128M
SNAPPYMAIL_UPLOAD_MAX_SIZE=25M