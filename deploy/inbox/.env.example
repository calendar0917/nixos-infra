# Template for deploy/inbox/.env — copy to .env (mode 0600) and fill in.
# The real .env is gitignored and must never be committed or pasted anywhere.
#
# This stack keeps no secret in .env: mailbox passwords and the encryption keys
# live in Gofer's data volume, ntfy credentials live in its auth database.
# .env stays ignored so anything added later does not leak.

# Pin versions; bump deliberately, never "latest".
# Gofer has not reached 1.0 and moves fast: read the release notes and back the
# volume up before bumping the minor version.
GOFER_IMAGE=ghcr.io/cristianadrielbraun/gofer:0.25.0
NTFY_IMAGE=binwiederhier/ntfy:v2.37.2

# Loopback ports; cloudflared reaches these from 127.0.0.1.
# Gofer listens on 8090 in the container and is published on 24080 because
# api.20050917.xyz already holds 127.0.0.1:8090 on this host.
GOFER_PORT=24080
NTFY_PORT=2586

# Must match the public hostname configured in the Cloudflare Tunnel.
GOFER_BASE_URL=https://mail.20050917.xyz
NTFY_BASE_URL=https://notify.20050917.xyz