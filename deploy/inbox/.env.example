# Template for deploy/inbox/.env — copy to .env (mode 0600) and fill in.
# The real .env is gitignored and must never be committed or pasted anywhere.

MARIADB_IMAGE=mariadb:10.11
CYPHT_IMAGE=cypht/cypht:2.12.2
NTFY_IMAGE=binwiederhier/ntfy:v2.37.2

# Loopback ports; cloudflared reaches these from 127.0.0.1.
CYPHT_PORT=24080
NTFY_PORT=2586

# Must match the public hostname configured in the Cloudflare Tunnel.
NTFY_BASE_URL=https://notify.20050917.xyz

# Cypht login (single local account) and its database.
CYPHT_AUTH_USERNAME=admin
CYPHT_AUTH_PASSWORD=change-me-long-random
CYPHT_DB_ROOT_PASSWORD=change-me-long-random
CYPHT_DB_PASSWORD=change-me-long-random