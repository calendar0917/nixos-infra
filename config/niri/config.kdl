// niri configuration for the main desktop.
// Mod = Super. Home Manager installs this file read-only from the flake.
// Only key bindings that are intentional personal habits are kept; layout,
// animations and colours are intentionally left at upstream defaults.
//
// The main host uses the modular Waybar shell from
// home/calendar/desktop/shell.nix. Panel, notifications, clipboard, wallpaper,
// lock and the network applet are started by niri-bound systemd user units,
// not by spawn-at-startup entries.
//
// Output layout is not configured here. kanshi applies the Profiles written by
// wdisplays, and `niri msg output ...` remains the on-demand override for the
// display menu. Do not re-add `include "monitor.kdl"`: that file is kept on
// disk only as a record of the earlier GUI-managed layout. Its `on` keyword is
// not valid niri KDL, so including it made niri fail to parse this file.

workspace "work"
workspace "web"
workspace "note"

input {
    keyboard {
        numlock
        repeat-delay 250
        repeat-rate 30
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }
}

layout {
    gaps 4
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        width 2
    }

    border {
        off
    }
}

// kitty is translucent (background_opacity 0.90). niri otherwise fills the
// focus-ring backdrop with an opaque colour, which makes a focused kitty look
// almost opaque. Keep the focus ring and the Catppuccin theme; only drop that
// backdrop for kitty.
window-rule {
    match app-id="^kitty$"
    draw-border-with-background false
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
    // ---------- System / launchers ----------
    Mod+O repeat=false { toggle-overview; }
    Mod+Tab repeat=false { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Terminal: kitty" { spawn "kitty"; }
    Mod+E hotkey-overlay-title="File manager: Nautilus" { spawn "nautilus"; }
    Mod+D hotkey-overlay-title="Application launcher: Fuzzel" { spawn "fuzzel"; }
    Alt+Space hotkey-overlay-title="Application launcher: Fuzzel" { spawn "fuzzel"; }
    Mod+M hotkey-overlay-title="System monitor: btop" { spawn "kitty" "btop"; }
    Mod+Alt+N hotkey-overlay-title="Notification center" { spawn "swaync-client" "-t" "-sw"; }
    Mod+P hotkey-overlay-title="Display settings: nwg-displays" { spawn "nwg-displays"; }
    // Staged display-mode entry. Keep Mod+P on nwg-displays until real output
    // switching through this menu has been verified on the laptop.
    Mod+Ctrl+P hotkey-overlay-title="Display mode menu" { spawn "niri-display-menu"; }

    Alt+L hotkey-overlay-title="Lock screen" { spawn "niri-lock"; }
    Alt+Shift+L hotkey-overlay-title="Power menu" { spawn "niri-power-menu"; }
    Mod+Alt+V hotkey-overlay-title="Clipboard history" { spawn "niri-clipboard-menu"; }

    // The main laptop's internal panel is eDP-1 (confirmed with
    // `niri msg outputs`). Mod+P opens nwg-displays and Mod+Ctrl+P opens the
    // display mode menu; this escape hatch turns the internal panel back on if
    // a GUI layout change or an external-only switch hides it.
    Mod+Alt+P hotkey-overlay-title="Enable internal output" { spawn-sh "niri msg output eDP-1 on"; }

    // Screen reader toggle kept from the old configuration.
    Mod+Alt+S { spawn-sh "pkill orca || exec orca"; }

    // ---------- Windows ----------
    Mod+Q repeat=false { close-window; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { spawn "kitty" "btop"; }

    // ---------- Audio, brightness and media ----------
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    Ctrl+XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "playerctl volume 0.05+"; }
    Ctrl+XF86AudioLowerVolume allow-when-locked=true { spawn-sh "playerctl volume 0.05-"; }
    // brightnessctl's --min-value takes a raw device value, not a percentage.
    // Compute 5% of the actual maximum so key repeats cannot reach 0.
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "max=$(brightnessctl --class=backlight max); brightnessctl --class=backlight --min-value=$(( (max * 5 + 99) / 100 )) set +10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "max=$(brightnessctl --class=backlight max); brightnessctl --class=backlight --min-value=$(( (max * 5 + 99) / 100 )) set 10%-"; }
    XF86TouchpadToggle allow-when-locked=true repeat=false { spawn "niri" "msg" "action" "toggle-touchpad"; }

    // ---------- Focus and window movement ----------
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    // Mod+Shift+L is intentionally still move-column-right. The power menu
    // in this repository is Alt+Shift+L; do not silently replace the common
    // column movement binding. A local user rebind can point at
    // niri-power-menu independently.
    Mod+Shift+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // ---------- Monitors ----------
    Mod+Alt+Left  { focus-monitor-left; }
    Mod+Alt+Down  { focus-monitor-down; }
    Mod+Alt+Up    { focus-monitor-up; }
    Mod+Alt+Right { focus-monitor-right; }
    Mod+Alt+H     { focus-monitor-left; }
    Mod+Alt+J     { focus-monitor-down; }
    Mod+Alt+K     { focus-monitor-up; }
    Mod+Alt+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // ---------- Workspaces ----------
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+N              { focus-workspace-down; }
    Mod+U              { focus-workspace-up; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Down      { move-column-to-workspace-down; }
    Mod+Ctrl+Up        { move-column-to-workspace-up; }
    Mod+Shift+N        { move-column-to-workspace-down; }
    Mod+Shift+U        { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Ctrl+U          { move-workspace-down; }
    Mod+Ctrl+I          { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // ---------- Columns and sizing ----------
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Alt+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    // ---------- Screenshots ----------
    Ctrl+Q { screenshot; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // ---------- Escape hatches ----------
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
}

// Alt+Tab is the old recent-window switcher. It is distinct from Mod+Tab,
// which still opens the niri overview.
recent-windows {
    binds {
        Alt+Tab { next-window scope="output"; }
        Alt+Shift+Tab { previous-window scope="output"; }
        Alt+grave { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}
