{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["custom/launcher", "cpu", "memory", "pulseaudio", "network", "battery", "clock", "tray"],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
    "on-click": "activate"
  },
  "sway/mode": {
    "format": "{}",
    "max-length": 30
  },
  "sway/window": {
    "max-length": 60,
    "format": "{}"
  },
  "custom/launcher": {
    "format": "menu",
    "tooltip": false,
    "on-click": "fuzzel"
  },
  "cpu": {
    "interval": 5,
    "format": "cpu {usage}%",
    "tooltip": false
  },
  "memory": {
    "interval": 5,
    "format": "mem {percentage}%",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
    "tooltip": false
  },
  "network": {
    "interval": 5,
    "format-wifi": "wifi {essid} {signalStrength}%",
    "format-ethernet": "eth {ifname}",
    "format-disconnected": "net offline",
    "tooltip": false
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "bat {capacity}%",
    "format-charging": "bat {capacity}% +",
    "format-plugged": "bat {capacity}% ac",
    "tooltip": false
  },
  "clock": {
    "interval": 30,
    "format": "{:%H:%M  %m-%d}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
  },
  "tray": {
    "spacing": 8
  }
}
