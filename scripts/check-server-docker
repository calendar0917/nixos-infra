#!/usr/bin/env bash
# Static regression for the headless Docker/Compose foundation. This parses
# the Compose example, optionally runs `docker compose config -q` without
# starting a container, and evaluates the NixOS configuration. It never
# accesses the Docker socket, switches generations, or touches persistent data.
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
compose_file="$repo_dir/deploy/nixos-smoke/compose.yaml"

if [ "$#" -gt 0 ]; then
  echo "check-server-docker: unexpected arguments: $*" >&2
  exit 2
fi

command -v nix >/dev/null 2>&1 || {
  echo "check-server-docker: nix is not on PATH" >&2
  exit 1
}

# `config -q` only parses/interpolates the file; it does not need the daemon.
# Skip this optional check when the Compose CLI is not installed.
if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
  docker compose -f "$compose_file" config -q
  echo "compose config: ok (docker compose)"
elif command -v docker-compose >/dev/null 2>&1; then
  docker-compose -f "$compose_file" config -q
  echo "compose config: ok (docker-compose)"
else
  echo "compose config: skipped (Docker Compose CLI not installed)"
fi

nixpkgs="$(nix eval --raw "$repo_dir#nixosConfigurations.nixos.pkgs.path")"
python_env="$(
  nix build --no-link --print-out-paths --impure --expr \
    "let p = import $nixpkgs { system = \"x86_64-linux\"; };
     in p.python3.withPackages (ps: [ ps.pyyaml ])"
)"

exec "$python_env/bin/python3" "$repo_dir/tests/test_server_docker.py"
