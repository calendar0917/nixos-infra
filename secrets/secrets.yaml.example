# 此文件是示例，实际使用时请复制为 secrets.yaml 并填入你的配置
# 然后用 sops 加密: sops --encrypt --in-place secrets/secrets.yaml
# 加密后可以安全提交到 git
mihomo-config: |
  # 你的 mihomo/clash 配置写在这里
  # 替换下方示例为你实际订阅生成的内容
  port: 7890
  socks-port: 7891
  mode: rule
  log-level: info
  external-controller: 127.0.0.1:9090
  dns:
    enable: true
    ipv6: false
